[Unit]
Description=LanDesk remote desktop host (LAN)
Documentation=file:///usr/share/doc/landesk/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/landesk --cli
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
